local function getCharacter()
    return lp.Character or lp.CharacterAdded:Wait()
end

local function getKillerFolder()
    local playersFolder = workspace:FindFirstChild("Players")
    if not playersFolder then return nil end
    return playersFolder:FindFirstChild("Killers")
end

local function getFirstValidKillerModel()
    local killerFolder = getKillerFolder()
    if not killerFolder then return nil end
    for _, inst in ipairs(killerFolder:GetDescendants()) do
        if inst:IsA("Model") then
            local hum = inst:FindFirstChildOfClass("Humanoid")
            local hrp = inst:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                return inst
            end
        end
    end
    return nil
end

local function getPing()
    local success, val = pcall(function()
        return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if success and val then return val end

    local success2, val2 = pcall(function()
        return lp:GetNetworkPing() * 1000
    end)
    if success2 and val2 then return val2 end

    return 20
end

local function runPlaceSequence()
    if not isEnabled or running then return end
    running = true

    local character = getCharacter()
    local hrp = character:WaitForChild("HumanoidRootPart")

    task.wait(startdelay)

    if not character.Parent then
        running = false
        return
    end

    local place = Instance.new("Part")
    place.Name = "place"
    place.Size = Vector3.new(2, 2, 2)
    place.Transparency = 0
    place.CanCollide = false
    place.Anchored = true
    place.Parent = character

    local originalPrimaryPart = character.PrimaryPart
    local oldspeed = speed.Value

    if moredirectenabled then
        moredirectrn = true
        task.wait(0.01)
        moredirectrn = false
    end

    local startTime = os.clock()
    while os.clock() - startTime < duration do
        if not character.Parent or not place.Parent or not isEnabled then break end
        speed.Value = 0
        doitmate = true
        RunService.PreRender:Wait()
    end

    if place and place.Parent then place:Destroy() end
    if character and character.Parent then character.PrimaryPart = originalPrimaryPart end

    speed.Value = oldspeed
    doitmate = false

    if moredirectenabled then
        moredirectrn = true
        task.wait(0.01)
        moredirectend = true
        moredirectrn = false
        task.wait(0.01)
        moredirectend = false
    end

    running = false
end

local function runDashstabSequence()
    if not isDashstabEnabled or running then return end
    running = true

    local character = getCharacter()

    task.wait(dsStartDelay)

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not character.Parent or not hrp then
        running = false
        return
    end

    local place = Instance.new("Part")
    place.Name = "place"
    place.Size = Vector3.new(2, 2, 2)
    place.Transparency = 0
    place.CanCollide = false
    place.Anchored = true
    place.Parent = character

    local originalPrimaryPart = character.PrimaryPart
    local oldspeed = speed.Value

    if moredirectenabled then
        moredirectrn = true
        task.wait(0.01)
        moredirectrn = false
    end

    local startTime = os.clock()
    while os.clock() - startTime < duration do
        if not character.Parent or not place.Parent or not isDashstabEnabled then break end
        speed.Value = 0
        doitmate = true
        RunService.PreRender:Wait()
    end

    speed.Value = oldspeed
    doitmate = false

    if moredirectenabled then
        moredirectrn = true
        task.wait(0.001)
        moredirectend = true
        moredirectrn = false
        task.wait(0.001)
        moredirectend = false
    end

    if place and place.Parent then place:Destroy() end
    if character and character.Parent then character.PrimaryPart = originalPrimaryPart end

    running = false
end

local player = Players.LocalPlayer

-- Network module + hookfunction
local NetworkModule = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Network"):WaitForChild("Network"))

local oldFireServerConnection
oldFireServerConnection = hookfunction(NetworkModule.FireServerConnection, function(self, connectionName, eventType, ...)
    local args = {...}

    if connectionName == "UpdateCharacterPosition" then
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local killerModel = getFirstValidKillerModel()
        if killerModel then
            local killerHrp = killerModel:FindFirstChild("HumanoidRootPart")
            if killerHrp then
                if hrp then
                    local targetCFrame    = killerHrp.CFrame * CFrame.new(0, 0, behindstuds)
                    local targetdirect    = hrp.CFrame * CFrame.new(0, -90000, 0)
                    local targetdirectend = hrp.CFrame * CFrame.new(0, 0, 0)

                    local CharacterReplication = require(
                        ReplicatedStorage:WaitForChild("Systems"):WaitForChild("Player"):WaitForChild("Game"):WaitForChild("CharacterReplication")
                    )
                    if moredirectrn then
                        args[1] = CharacterReplication.Serialize(targetdirect, hrp.AssemblyLinearVelocity)
                    elseif moredirectend then
                        args[1] = CharacterReplication.Serialize(targetdirectend, hrp.AssemblyLinearVelocity)
                    elseif doitmate then
                        args[1] = CharacterReplication.Serialize(targetCFrame, hrp.AssemblyLinearVelocity)
                    end
                end
            end
        end
    end

    return oldFireServerConnection(self, connectionName, eventType, unpack(args))
end)

local function check(hrp1, hrp2, range)
    if not hrp1 or not hrp2 then return false end
    return (hrp1.Position - hrp2.Position).Magnitude <= range
end

local function hookCharacter(character)
    local humanoid = character:WaitForChild("Humanoid")
    local animator = humanoid:FindFirstChild("Animator")
    if not animator then return end

    animator.AnimationPlayed:Connect(function(track)
        if not track or not track.Animation then return end
        local killer = getFirstValidKillerModel()
        if not killer then return end
        local id = tostring(track.Animation.AnimationId or ""):gsub("%D", "")

        if (id == TARGET_ANIMATION_ID or id == "106086955212611") and isEnabled then
            if distcheck then
                if not check(character.HumanoidRootPart, killer.HumanoidRootPart, distcheckstud) then return end
            end
            task.spawn(runPlaceSequence)
        elseif (id == DASHSTAB_ANIM_ID or id == "107640065977686") and isDashstabEnabled then
            if distcheck then
                if not check(character.HumanoidRootPart, killer.HumanoidRootPart, distcheckstud) then return end
            end
            task.spawn(runDashstabSequence)
        end
    end)
end

-- Auto Studs — dynamic behindstuds calculation
local lastKillerModel = nil
local lastKillerPos = nil
local smoothedSpeed = 0

RunService.Heartbeat:Connect(function(dt)
    if isAutoStudsEnabled then
        local killerModel = getFirstValidKillerModel()
        if killerModel then
            local killerHrp = killerModel:FindFirstChild("HumanoidRootPart")
            if killerHrp then
                local currentPos = killerHrp.Position
                local rawSpeed = 0

                if lastKillerModel == killerModel and lastKillerPos then
                    local horizontalDelta = Vector3.new(currentPos.X, 0, currentPos.Z) - Vector3.new(lastKillerPos.X, 0, lastKillerPos.Z)
                    rawSpeed = horizontalDelta.Magnitude / dt
                end

                lastKillerModel = killerModel
                lastKillerPos = currentPos

                smoothedSpeed = smoothedSpeed + (rawSpeed - smoothedSpeed) * math.min(dt * 15, 1)
                local finalSpeed = math.clamp(smoothedSpeed, 0, 30)

                local studsAtRun = autoRunStuds
                if isDetectPingEnabled then
                    local ping = getPing()
                    local clampedPing = math.max(ping, 20)
                    studsAtRun = autoRunStuds - ((clampedPing - 20) / 100) * 1.5
                    studsAtRun = math.max(studsAtRun, 1.0)
                end

                local slope = (autoStandStuds - studsAtRun) / 26.0
                local calculatedStuds = autoStandStuds - (finalSpeed * slope)

                behindstuds = calculatedStuds

                if not behindStudsBox:IsFocused() then
                    behindStudsBox:Set(string.format("%.1f", calculatedStuds))
                end
            else
                lastKillerModel = nil
            end
        else
            lastKillerModel = nil
            smoothedSpeed = 0
        end
    else
        lastKillerModel = nil
        smoothedSpeed = 0
    end
end)

if lp.Character then
