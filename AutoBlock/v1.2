-- ==========================================
-- Helpers
-- ==========================================
local function getKillersFolder()
    local p = Workspace:FindFirstChild("Players")
    return p and p:FindFirstChild("Killers")
end

local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function fireBlock()
    if not RemoteEvent then return end
    pcall(function()
        RemoteEvent:FireServer("UseActorAbility", {[1] = buffer.fromstring("\3\5\0\0\0Block")})
    end)
end

local function firePunch()
    if not RemoteEvent then return end
    pcall(function()
        RemoteEvent:FireServer("UseActorAbility", {[1] = buffer.fromstring("\3\5\0\0\0Punch")})
    end)
end

local function isFacing(myRoot, targetRoot)
    if not Config.FaceCheck then return true end
    if not myRoot or not targetRoot then return false end
    local diff = myRoot.Position - targetRoot.Position
    if diff.Magnitude < 0.01 then return true end
    return targetRoot.CFrame.LookVector:Dot(diff.Unit) > Config.FacingDot
end

local function isBeheading(killer)
    if not killer then return false end
    if killer:FindFirstChild("BeheadAbility") then return true end
    local hum = killer:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            local id = tostring(track.Animation.AnimationId):match("%d+")
            if id and BEHEAD_ANIMS[id] then return true end
        end
    end
    return false
end

local function isBlockReady()
    return tick() - blockLastTime >= Config.BlockCooldown
end

local function doBlock(killer)
    if not isBlockReady() then return end
    blockLastTime = tick()

    if Config.BlockDelay > 0 then task.wait(Config.BlockDelay) end
    fireBlock()

    if Config.AutoPunch then
        task.delay(Config.PunchDelay, firePunch)
    end
end

-- ==========================================
-- Animation Detection
-- ==========================================
local function setupAnimBlock()
    if animConn then animConn:Disconnect(); animConn = nil end
    if not Config.Enabled then return end

    animConn = RunService.Heartbeat:Connect(function()
        if not Config.Enabled then return end
        local myRoot = getRoot()
        if not myRoot then return end
        local kf = getKillersFolder()
        if not kf then return end

        for _, killer in ipairs(kf:GetChildren()) do
            local hrp = killer:FindFirstChild("HumanoidRootPart")
            local hum = killer:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then continue end

            local dist = (hrp.Position - myRoot.Position).Magnitude
            if dist > Config.Range then continue end
            if not isFacing(myRoot, hrp) then continue end
            if isBeheading(killer) then continue end

            local animator = hum:FindFirstChildOfClass("Animator")
            if not animator then continue end

            local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
            if not ok then continue end

            for _, track in ipairs(tracks) do
                local id
                pcall(function()
                    id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
                end)
                if id and TRIGGER_ANIMS[id] then
                    doBlock(killer)
                    break
                end
            end
        end
    end)
end

-- ==========================================
-- Sound Detection
-- ==========================================
local function hookSound(sound)
    if not sound or not sound:IsA("Sound") or soundHooks[sound] then return end
    local id = tostring(sound.SoundId):match("%d+")
    if not id or not TRIGGER_SOUNDS[id] then return end

    local function attempt()
        if not Config.Enabled then return end
        if soundBlockedUntil[sound] and tick() < soundBlockedUntil[sound] then return end

        local root = getRoot()
        if not root then return end

        local part = sound.Parent
        if not part or not part:IsA("BasePart") then
            local att = sound.Parent
            if att and att:IsA("Attachment") then part = att.Parent end
        end
        if not part then return end

        local killer = part:FindFirstAncestorOfClass("Model")
        if not killer then return end
        if isBeheading(killer) then return end

        local hrp = killer:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local dist = (hrp.Position - root.Position).Magnitude
        if dist > Config.Range then return end
        if not isFacing(root, hrp) then return end

        doBlock(killer)
        soundBlockedUntil[sound] = tick() + 0.5
    end

    local pc = sound.Played:Connect(attempt)
    local pp = sound:GetPropertyChangedSignal("IsPlaying"):Connect(function()
        if sound.IsPlaying then attempt() end
    end)
    local dc
    dc = sound.Destroying:Connect(function()
        pcall(function() pc:Disconnect(); pp:Disconnect(); dc:Disconnect() end)
        soundHooks[sound] = nil
        soundBlockedUntil[sound] = nil
    end)

    soundHooks[sound] = {pc, pp, dc}
    if sound.IsPlaying then attempt() end
end

task.spawn(function()
    local pf = Workspace:FindFirstChild("Players")
    if not pf then pf = Workspace:WaitForChild("Players", 30) end
    if not pf then return end
    local kf = pf:FindFirstChild("Killers")
    if not kf then kf = pf:WaitForChild("Killers", 30) end
    if not kf then return end

    for _, killer in pairs(kf:GetChildren()) do
        for _, d in pairs(killer:GetDescendants()) do
            if d:IsA("Sound") then pcall(hookSound, d) end
        end
    end
    kf.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then pcall(hookSound, d) end
    end)
end)

-- ==========================================
-- Range Visualizer
-- ==========================================
local function updateRangeVisual()
    if not Config.ShowRange or not Config.Enabled then
        for _, p in ipairs(rangeParts) do if p then p:Destroy() end end
        rangeParts = {}
        return
    end

    local myRoot = getRoot()
    if not myRoot then return end
    local kf = getKillersFolder()
    if not kf then return end

    for _, p in ipairs(rangeParts) do if p then p:Destroy() end end
    rangeParts = {}

    for _, killer in ipairs(kf:GetChildren()) do
        local hrp = killer:FindFirstChild("HumanoidRootPart")
        if hrp then
            if (hrp.Position - myRoot.Position).Magnitude <= Config.Range then
                local p = Instance.new("Part")
                p.Shape = Enum.PartType.Ball
                p.Size = Vector3.new(1, 1, 1)
                p.Anchored = true
                p.CanCollide = false
                p.Transparency = 0.6
                p.Color = Color3.fromRGB(0, 255, 100)
                p.Position = hrp.Position
                p.Parent = Workspace
                table.insert(rangeParts, p)
            end
        end
    end
end

RunService.Heartbeat:Connect(function() pcall(updateRangeVisual) end)

