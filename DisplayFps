-- Safe click (mobile + PC)
local function clickButton(btnName)
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return end

    local mainUI = gui:FindFirstChild("MainUI")
    local container = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local button = container and container:FindFirstChild(btnName)

    if button and button:IsA("ImageButton") and button.Visible then
        for _, conn in ipairs(getconnections(button.MouseButton1Click)) do
            pcall(function()
                conn:Fire()
            end)
        end
    end
end

-- Aim at target
local function aimAtTarget(targetRoot)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and targetRoot then
        hrp.CFrame = CFrame.new(
            hrp.Position,
            Vector3.new(targetRoot.Position.X, hrp.Position.Y, targetRoot.Position.Z)
        )
    end
end

-- Predictive block setup (fixed keyword + ID matching)
local function setupPredictiveBlock(humanoid, targetRoot)
    humanoid.AnimationPlayed:Connect(function(track)
        if not toggleOn then return end

        local anim = track.Animation
        if not anim or not anim.AnimationId then return end

        local id = string.match(anim.AnimationId, "%d+")
        local animName = anim.Name:lower()

        -- Range check
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local dist = (targetRoot.Position - myRoot.Position).Magnitude
        if dist > detectionRange then return end

        -- Keyword matching (slash, punch, stab, etc.)
        local keywords = {
            "slash", "punch", "stab",
            "lacerate", "perforating", "carving",
        }
        local isKeywordMatch = false
        for _, word in ipairs(keywords) do
            if animName:find(word, 1, true) then
                isKeywordMatch = true
                break
            end
        end

        -- Fire block if anim ID is trusted OR name contains a keyword
        if trustedAnimationIds[id] or isKeywordMatch then
            clickButton("Block")

            -- Auto punch after block
            if autoPunchOn then
                task.wait(0.1)
                aimAtTarget(targetRoot)
                clickButton("Punch")
            end
        end
    end)
end

