local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

-- Load Rayfield UI Library
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

-- ==========================================
-- 1. STATE & CONFIGURATION
-- ==========================================
local AutoBlockEnabled = false
local BlockableAttacks = {"slash", "enragedslash", "stab", "attack", "punch", "swing", "golemslash"}

local CustomHitboxes = {
    ["golemslash"] = {
        Size = Vector3.new(6, 2, 7),
        Offset = CFrame.new(0, 0, -5.5)
    }
}

-- References (Ensure these globals match your script environment)
local LocalCharacter = Players.LocalPlayer.Character or Players.LocalPlayer.CharacterAdded:Wait()
local SurvivorsFolder = Workspace:FindFirstChild("Survivors") or Workspace:FindFirstChild("SurvivorsFolder")
local KillersFolder = Workspace:FindFirstChild("Killers") or Workspace:FindFirstChild("KillersFolder")
local Hitboxes = Workspace:FindFirstChild("Hitboxes") or Workspace
local MainUI = Players.LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("MainUI")
local Network = ReplicatedStorage:FindFirstChild("Network")
local PlayerData = Players.LocalPlayer:FindFirstChild("PlayerData")

-- Helper functions
local FireSignal = GetFunction and GetFunction(firesignal, FireSignal) or firesignal
local UseActorAbility = Network and Network:FindFirstChildOfClass("RemoteEvent")
local ShowHitboxesSetting = PlayerData and PlayerData:FindFirstChild("Settings") and PlayerData.Settings:FindFirstChild("ShowHitboxes", true)

-- Maintain character state on respawn
Players.LocalPlayer.CharacterAdded:Connect(function(Char)
    LocalCharacter = Char
end)

-- ==========================================
-- 2. UI INDICATOR MANAGEMENT
-- ==========================================
local function UpdateAutoBlockUI(enabled)
    if not MainUI then return end
    local AbilityContainer = MainUI:FindFirstChild("AbilityContainer")
    if not AbilityContainer then return end
    local BlockButton = AbilityContainer:FindFirstChild("Block")
    if not BlockButton then return end

    local AutoImage = BlockButton:FindFirstChild("AutoImage")
    if enabled then
        if not AutoImage then
            AutoImage = Instance.new("ImageLabel")
            AutoImage.Name = "AutoImage"
            AutoImage.Interactable = false
            AutoImage.Parent = BlockButton
            AutoImage.Image = "rbxassetid://114159864966636"
            AutoImage.BackgroundTransparency = 1
            AutoImage.Size = UDim2.fromScale(0.8, 0.8)
            AutoImage.Position = UDim2.fromScale(0.5, 0)
            AutoImage.AnchorPoint = Vector2.new(0.5, 0.4)
        end
        AutoImage.Visible = true
    elseif AutoImage then
        AutoImage.Visible = false
    end
end

-- ==========================================
-- 3. KILLER HITBOX DETECTION & AUTO BLOCK
-- ==========================================
local function HandleKiller(Killer)
    local Humanoid = Killer:FindFirstChildOfClass("Humanoid") or Killer:WaitForChild("Humanoid", 5)
    local QueryHitbox = Killer:FindFirstChild("QueryHitbox") or Killer:WaitForChild("QueryHitbox", 5)
    if not Humanoid or not QueryHitbox then return end

    local KillerAnimator = Humanoid:FindFirstChildOfClass("Animator") or Humanoid:WaitForChild("Animator", 5)
    if not KillerAnimator then return end

    KillerAnimator.AnimationPlayed:Connect(function(Track)
        if not AutoBlockEnabled then return end
        if not Players:GetPlayerFromCharacter(Killer) then return end

        local AnimType, KillerName = GetAnimationType(Track.Animation.AnimationId)
        local isSurvivor = LocalCharacter and LocalCharacter.Parent == SurvivorsFolder
        local hasHitbox = LocalCharacter and LocalCharacter:FindFirstChild("QueryHitbox")
        local hasBlockUI = MainUI and MainUI:FindFirstChild("AbilityContainer") and MainUI.AbilityContainer:FindFirstChild("Block")

        if AnimType and type(AnimType) == "string" and table.find(BlockableAttacks, AnimType:lower()) and isSurvivor and hasHitbox and hasBlockUI then
            local CustomHitbox = CustomHitboxes[AnimType:lower()] or CustomHitboxes[Killer.Name:lower()]
            local SelfParams = OverlapParams.new()
            SelfParams.MaxParts = 1
            SelfParams.FilterType = Enum.RaycastFilterType.Include

            for i = 1, 12 do
                if not AutoBlockEnabled then break end
                
                SelfParams.FilterDescendantsInstances = {LocalCharacter:FindFirstChild("QueryHitbox")}
                
                local Part = Instance.new("Part")
                Part.Name = "KillerDetectHitbox"
                Part.Color = BrickColor.new("Really black").Color
                Part.Size = (CustomHitbox and CustomHitbox["Size"] or Vector3.new(5, 5, 6)) * 2.2
                Part.CFrame = QueryHitbox.CFrame * (CustomHitbox and CustomHitbox["Offset"] or CFrame.new(0, 0, -3.5))
                Part.CanCollide = false
                Part.Anchored = true
                Part.CastShadow = false
                Part.Material = Enum.Material.ForceField
                Part.Transparency = (ShowHitboxesSetting and ShowHitboxesSetting.Value) and 0.1 or 1
                Part.Parent = Hitboxes
                Debris:AddItem(Part, 0.4)

                local Hitbox = Workspace:GetPartsInPart(Part, SelfParams)
                if #Hitbox > 0 then
                    if FireSignal and MainUI.AbilityContainer:FindFirstChild("Block") then
                        FireSignal(MainUI.AbilityContainer.Block.MouseButton1Click)
                        break
                    end
                    
                    if UseActorAbility then
                        if GetValue and GetValue("OfficialGame") then
                            UseActorAbility:FireServer("UseActorAbility", {"Block"})
                        else
                            UseActorAbility:FireServer("UseActorAbility", "Block")
                            UseActorAbility:FireServer("UseActorAbility", {"Block"})
                        end
                    end
                    break
                end
                task.wait(0.02)
            end
        end
    end)
end

-- Monitor existing and incoming killers
if KillersFolder then
    KillersFolder.ChildAdded:Connect(HandleKiller)
    for _, Killer in ipairs(KillersFolder:GetChildren()) do
        HandleKiller(Killer)
    end
end

-- Listener to dynamically attach UI icon when MainUI recreates
if MainUI then
    MainUI.ChildAdded:Connect(function(child)
        if child.Name == "AbilityContainer" then
            UpdateAutoBlockUI(AutoBlockEnabled)
        end
    end)
end

-- ==========================================
-- 4. RAYFIELD UI CREATION
-- ==========================================
local Window = Rayfield:CreateWindow({
    Name = "Fish1337",
    LoadingTitle = "Loading...",
    LoadingSubtitle = "Auto-Block",
    ConfigurationSaving = {
        Enabled = false
    },
    KeySystem = false
})

local CombatTab = Window:CreateTab("Combat", 4483362458)

CombatTab:CreateToggle({
    Name = "Guest1337 Auto Block",
    CurrentValue = false,
    Flag = "AutoBlockToggle",
    Callback = function(Value)
        AutoBlockEnabled = Value
        UpdateAutoBlockUI(Value)
    end,
})
