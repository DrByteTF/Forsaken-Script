local hookedSounds = {}
local soundCache = setmetatable({}, {__mode = "k"})

local IgnoredKeywords = {
    "behead", "pizza delivery", "pizza delivery bot", "bot",
    "corrupt nature", "corruptnature", "minion"
}

local function isIgnoredSoundSource(sound)
    if not sound then return true end
    local soundName = string.lower(sound.Name)
    for _, keyword in ipairs(IgnoredKeywords) do
        if string.find(soundName, keyword) then return true end
    end
    local current = sound.Parent
    while current and current ~= Workspace do
        local currentName = string.lower(current.Name)
        for _, keyword in ipairs(IgnoredKeywords) do
            if string.find(currentName, keyword) then return true end
        end
        current = current.Parent
    end
    return false
end

local function setupSound(sound)
    if not sound:IsA("Sound") or hookedSounds[sound] then return end
    hookedSounds[sound] = true

    local function onSoundEvent()
        if not Settings.AutoBlockSound then return end
        if isIgnoredSoundSource(sound) then return end

        local rawId = sound.SoundId
        if not rawId or rawId == "" then return end
        local numId = string.match(rawId, "%d+$")
        if not numId then return end
        if BeheadIDs[numId] then return end
        if not KillerSounds[numId] then return end

        local cache = soundCache[sound]
        if cache and (os.clock() - cache.lastTime) < 0.05 then return end
        soundCache[sound] = {lastTime = os.clock()}

        local character = sound:FindFirstAncestorOfClass("Model")
        if not character or isBeheadSkill(character) then return end
        if character == LocalPlayer.Character then return end

        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local hrp = character:FindFirstChild("HumanoidRootPart")

        if myHRP and hrp then
            local dist = (myHRP.Position - hrp.Position).Magnitude
            if numId == "119583605486352" and dist <= 11 then
                performBlockInstant()
            else
                local maxReach = Settings.BoxSizeDepth + Settings.HitboxDistance + 3
                if dist <= maxReach then
                    performBlockInstant()
                end
            end
        end
        spawnHitboxAndCheck(character)
    end

    sound.Played:Connect(onSoundEvent)
    sound:GetPropertyChangedSignal("Playing"):Connect(function()
        if sound.IsPlaying then onSoundEvent() end
    end)
    if sound.IsPlaying then onSoundEvent() end
end

task.spawn(function()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Sound") then setupSound(obj) end
    end
    Workspace.DescendantAdded:Connect(function(obj)
        if obj:IsA("Sound") then setupSound(obj) end
    end)
end)

