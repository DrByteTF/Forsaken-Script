-- ==========================================
-- Behead Detector
-- ==========================================
local currentlyBeheading = {}
local activeHitboxes = {}
local hitboxConnections = {}

local function getAnimId(animIdStr)
    return animIdStr and string.match(tostring(animIdStr), "%d+")
end

local function killHitboxImmediately(character)
    if activeHitboxes[character] then activeHitboxes[character]:Destroy(); activeHitboxes[character] = nil end
    if hitboxConnections[character] then hitboxConnections[character]:Disconnect(); hitboxConnections[character] = nil end
end

local function isBeheadSkill(character)
    if not Settings.IgnoreBehead or not character then return false end
    if currentlyBeheading[character] then return true end
    if character:FindFirstChild("BeheadAbility") then return true end
    for _, child in ipairs(character:GetChildren()) do
        local childName = string.lower(child.Name)
        if childName == "behead" or string.find(childName, "behead_") then return true end
    end
    return false
end

local function hookCharacterAnimations(character)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 3)
    local animator = humanoid and humanoid:WaitForChild("Animator", 3)
    if animator then
        animator.AnimationPlayed:Connect(function(track)
            if not Settings.IgnoreBehead then return end
            if track.Animation then
                local playId = getAnimId(track.Animation.AnimationId)
                if playId and BeheadIDs[playId] then
                    currentlyBeheading[character] = true
                    killHitboxImmediately(character)
                    task.delay(track.Length > 0 and track.Length or 2.5, function()
                        currentlyBeheading[character] = nil
                    end)
                end
            end
        end)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player.Character then task.spawn(function() hookCharacterAnimations(player.Character) end) end
    player.CharacterAdded:Connect(function(char) task.spawn(function() hookCharacterAnimations(char) end) end)
end
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(char) task.spawn(function() hookCharacterAnimations(char) end) end)
end)

