-- Behead Skill Detector
-- ==========================================
local currentlyBeheading = {}
local activeHitboxes = {}
local hitboxConnections = {}

local function getAnimId(animIdStr)
    return animIdStr and string.match(tostring(animIdStr), "%d+")
end

local function killHitboxImmediately(character)
    if activeHitboxes[character] then
        activeHitboxes[character]:Destroy()
        activeHitboxes[character] = nil
    end
    if hitboxConnections[character] then
        hitboxConnections[character]:Disconnect()
        hitboxConnections[character] = nil
    end
end

local function isBeheadSkill(character)
    if not Settings.IgnoreBehead or not character then return false end
    if character:FindFirstChild("BeheadAbility") then return true end
    if currentlyBeheading[character] then return true end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if track.Animation then
                local playId = getAnimId(track.Animation.AnimationId)
                if playId and BeheadIDs and BeheadIDs[playId] then
                    currentlyBeheading[character] = true
                    task.delay(track.Length > 0 and track.Length or 1.5, function() currentlyBeheading[character] = nil end)
                    return true
                end
            end
        end
    end
    for _, child in ipairs(character:GetChildren()) do
        if string.find(string.lower(child.Name), "behead") then
            currentlyBeheading[character] = true
            task.delay(1.5, function() currentlyBeheading[character] = nil end)
            return true
        end
    end
    return false
end

local function hookCharacterAnimations(character)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 3)
    local animator = humanoid and humanoid:WaitForChild("Animator", 3)
    if animator then
        animator.AnimationPlayed:Connect(function(track)
            if not Settings.IgnoreBehead then return end
            if track.Animation then
                local playId = getAnimId(track.Animation.AnimationId)
                if playId and BeheadIDs and BeheadIDs[playId] then
                    currentlyBeheading[character] = true
                    killHitboxImmediately(character)
                    task.delay(track.Length > 0 and track.Length or 2, function() currentlyBeheading[character] = nil end)
                end
            end
        end)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
