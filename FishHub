local function setupAimbotButton(button)
    if hookedAimbotButtons[button] then return end
    hookedAimbotButtons[button] = true
    local function triggerAimbot()
        if not Settings.AimbotEnabled then return end
        if button.Name == "Punch" then
            local target = getNearestKiller(Settings.AimbotRange or 40)
            if target then startAimbot(target, Settings.AimbotDuration or 1) end
