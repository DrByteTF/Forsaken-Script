    local existingUI = PlayerGui:FindFirstChild("PuzzleUI")
    if existingUI then
        if Settings.HidePuzzleUI then existingUI.Enabled = false end
        existingUI:GetPropertyChangedSignal("Enabled"):Connect(function()
            if Settings.HidePuzzleUI and existingUI.Enabled then existingUI.Enabled = false end
        end)
    end
end

