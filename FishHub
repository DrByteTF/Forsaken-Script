local HitboxPool = {}
local function initHitboxPool()
    for i = 1, 15 do
        local box = Instance.new("Part")
        box.Name = "Fast_Predict_Box_" .. i
        box.Size = Vector3.new(Settings.BoxSizeWidth, Settings.BoxSizeHeight, Settings.BoxSizeDepth)
        box.Color = Settings.BoxColor
        box.Transparency = 1
        box.Material = Settings.GlowMode and Enum.Material.Neon or Enum.Material.SmoothPlastic
        box.CanCollide, box.CanQuery, box.Massless, box.Anchored = false, false, true, true
        box.CFrame = CFrame.new(0, 99999, 0)
        box.Parent = Workspace
        table.insert(HitboxPool, {Part = box, InUse = false})
    end
end
task.spawn(initHitboxPool)

local function getHitboxFromPool()
    for _, data in ipairs(HitboxPool) do
        if not data.InUse then
            data.InUse = true
            data.Part.Color = Settings.BoxColor
            return data
        end
    end
    return nil
end

local function releaseHitbox(boxData)
    if boxData and boxData.Part then
        boxData.InUse = false
        boxData.Part.Transparency = 1
        boxData.Part.CFrame = CFrame.new(0, 99999, 0)
    end
end

-- ==========================================
-- Pre-Simulation Hitbox Loop
-- ==========================================
local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Include

local function spawnHitboxAndCheck(character, customConfig)
    if isInLobby(character) or isBeheadSkill(character) or hitboxConnections[character] then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local activeVisibleTime = (customConfig and customConfig.visibleTime) or Settings.VisibleTime
    local boxSize = Vector3.new(Settings.BoxSizeWidth, Settings.BoxSizeHeight, Settings.BoxSizeDepth)
    local forwardOffset = - (Settings.BoxSizeDepth / 2) - Settings.HitboxDistance
    local boxData = getHitboxFromPool()
    if not boxData then return end
    local box = boxData.Part
    activeHitboxes[character] = boxData
    box.Size = boxSize
    local startTime = os.clock()
    local hasTriggeredBlock = false
    hitboxConnections[character] = RunService.Stepped:Connect(function()
        local timeAlive = os.clock() - startTime
        if timeAlive > activeVisibleTime or currentlyBeheading[character] or isBeheadSkill(character) then
            releaseHitbox(boxData)
            activeHitboxes[character] = nil
            hitboxConnections[character]:Disconnect()
            hitboxConnections[character] = nil
            return
        end
        if hrp then
            box.CFrame = hrp.CFrame * CFrame.new(0, 0, forwardOffset)
        end
        box.Transparency = Settings.HitboxEnabled and Settings.BoxTransparency or 1
        if character ~= LocalPlayer.Character and Settings.MasterAutoBlock and not hasTriggeredBlock then
            local currentMyChar = LocalPlayer.Character
            if currentMyChar then
                overlapParams.FilterDescendantsInstances = {currentMyChar}
                local partsInBox = Workspace:GetPartBoundsInBox(box.CFrame, boxSize, overlapParams)
                if #partsInBox > 0 then
                    hasTriggeredBlock = true
                    box.Color = Color3.fromRGB(255, 0, 0)
                    performBlock()
                end
            end
        end
    end)
end

-- ==========================================
-- Zero-Delay Math Injection Check
-- ==========================================
local hookedSounds = {}
local soundDataCache = setmetatable({}, { __mode = "k" })

local IgnoredKeywords = {
    "behead", "pizza delivery", "pizza delivery bot", "bot",
    "corrupt nature", "corruptnature", "minion", "clone"
}

local function isIgnoredSoundSource(sound)
    if not sound then return true end
    local soundName = string.lower(sound.Name)
    for _, keyword in ipairs(IgnoredKeywords) do
        if string.find(soundName, keyword) then return true end
    end
    local current = sound.Parent
    while current and current ~= Workspace do
        local currentName = string.lower(current.Name)
        for _, keyword in ipairs(IgnoredKeywords) do
            if string.find(currentName, keyword) then return true end
        end
        current = current.Parent
    end
    return false
end

local function setupSound(sound)
    if not sound:IsA("Sound") or hookedSounds[sound] then return end
    hookedSounds[sound] = true

    local function refreshSoundCache()
        local rawId = sound.SoundId
        if not rawId or rawId == "" then soundDataCache[sound] = nil return end
        local numId = string.match(rawId, "%d+$")
        if not numId then soundDataCache[sound] = nil return end
        if isIgnoredSoundSource(sound) then soundDataCache[sound] = nil return end
        local isBehead = BeheadIDs and BeheadIDs[numId] == true
        local isKiller = KillerSounds and KillerSounds[numId] == true
        if not isKiller or isBehead then soundDataCache[sound] = nil return end
        soundDataCache[sound] = {
            numId = numId,
            character = sound:FindFirstAncestorOfClass("Model"),
            customConfig = SoundCustomConfig and SoundCustomConfig[numId],
            lastTriggerTime = 0
        }
    end

    refreshSoundCache()
    sound:GetPropertyChangedSignal("SoundId"):Connect(refreshSoundCache)
    sound:GetPropertyChangedSignal("Parent"):Connect(refreshSoundCache)

    local function onSoundTriggered()
        if not Settings.AutoBlockSound then return end
        if isIgnoredSoundSource(sound) then return end
        local cache = soundDataCache[sound]
        if not cache then return end
        local currentTime = os.clock()
        if currentTime - cache.lastTriggerTime < 0.05 then return end
        cache.lastTriggerTime = currentTime
        local character = cache.character or sound:FindFirstAncestorOfClass("Model")
        if not character or isBeheadSkill(character) then return end
        if not cache.character then cache.character = character end

        if character ~= LocalPlayer.Character and Settings.MasterAutoBlock then
            local myChar = LocalPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if myHRP and hrp then
                local maxReach = Settings.BoxSizeDepth + Settings.HitboxDistance + 3
                local diff = myHRP.Position - hrp.Position
                local distSq = (diff.X * diff.X) + (diff.Y * diff.Y) + (diff.Z * diff.Z)
                if distSq <= (maxReach * maxReach) then
                    local forwardOffset = - (Settings.BoxSizeDepth / 2) - Settings.HitboxDistance
                    local boxCenter = hrp.CFrame * CFrame.new(0, 0, forwardOffset)
                    local localPos = boxCenter:ToObjectSpace(myHRP.CFrame).Position
                    local halfW = Settings.BoxSizeWidth / 2
                    local halfH = Settings.BoxSizeHeight / 2
                    local halfD = Settings.BoxSizeDepth / 2
                    if math.abs(localPos.X) <= halfW and math.abs(localPos.Y) <= halfH and math.abs(localPos.Z) <= halfD then
                        performBlock()
                    end
                end
            end
        end
        spawnHitboxAndCheck(character, cache.customConfig)
    end

    sound.Played:Connect(onSoundTriggered)
    sound:GetPropertyChangedSignal("Playing"):Connect(function()
        if sound.IsPlaying then onSoundTriggered() end
    end)
    if sound.IsPlaying then onSoundTriggered() end
end

local function initSoundDetection()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Sound") then setupSound(obj) end
    end
    Workspace.DescendantAdded:Connect(function(obj)
        if obj:IsA("Sound") then setupSound(obj) end
    end)
end

initSoundDetection()

