local function getNearestKiller(maxRange)
    local character = LocalPlayer.Character
    if not character then return nil end
    local myHRP = character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    local nearest = nil
    local nearestDistance = maxRange or Settings.AimbotRange or 40

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetChar = player.Character
            local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
            local humanoid = targetChar:FindFirstChildOfClass("Humanoid")

            if targetHRP and humanoid and humanoid.Health > 0 and not isInLobby(targetChar) then
                local charName = string.lower(targetChar.Name)
                local playerName = string.lower(player.Name)

                local isKiller = false
                if KillerNamesList then
                    for kName in pairs(KillerNamesList) do
                        if string.find(charName, kName) or string.find(playerName, kName) then
                            isKiller = true
                            break
                        end
                    end
                else
                    isKiller = true
                end

                if isKiller then
                    local distance = (targetHRP.Position - myHRP.Position).Magnitude
                    if distance <= nearestDistance then
                        nearestDistance = distance
                        nearest = targetHRP
                    end
                end
            end
        end
    end
    return nearest
end

