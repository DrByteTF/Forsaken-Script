-- COMBAT — Dusekkar Aimbot
-- ==========================================
local DusekSec = Combat:Section({ Title = "Dusekkar Aimbot", Opened = false })

local dusekEnabled = false
local dusekMode = "Survivor"
local dusekAnimIds = {"77894750279891", "118933622288262"}
local dusekKillerNames = {"Slasher","c00lkidd","JohnDoe","1x1x1x1","Noli","Sixer","Nosferatu"}
local dusekHealthPenalty = 1000
local dusekAiming = false
local dusekHumanoid, dusekAnimConn

local function getNearestDusekTarget()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local survivors = PlayersFolder:FindFirstChild("Survivors")
    local killers = PlayersFolder:FindFirstChild("Killers")
    local best, bestScore = nil, math.huge

    local function check(model, isKiller)
        if not model:IsA("Model") or model == char then return end
        if isKiller and not table.find(dusekKillerNames, model.Name) then return end
        if not isKiller and table.find(dusekKillerNames, model.Name) then return end
        local tHRP = model:FindFirstChild("HumanoidRootPart")
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not tHRP or not hum or hum.Health <= 0 then return end
        local dist = (tHRP.Position - hrp.Position).Magnitude^2
        local score = dist + (dusekHealthPenalty * (hum.Health / math.max(hum.MaxHealth,1)))
        if score < bestScore then bestScore = score; best = tHRP end
    end

    if dusekMode == "Survivor" and survivors then
        for _, m in ipairs(survivors:GetChildren()) do check(m, false) end
    elseif dusekMode == "Killer" and killers then
        for _, m in ipairs(killers:GetChildren()) do check(m, true) end
    elseif dusekMode == "Random" then
        if survivors then for _, m in ipairs(survivors:GetChildren()) do check(m,false) end end
        if killers then for _, m in ipairs(killers:GetChildren()) do check(m,true) end end
    end
    return best
end

local function setupDusekChar(char)
    dusekHumanoid = char:WaitForChild("Humanoid", 5)
    if not dusekHumanoid then return end
    if dusekAnimConn then pcall(function() dusekAnimConn:Disconnect() end) end

    local animator = dusekHumanoid:FindFirstChildOfClass("Animator")
    if animator then
        dusekAnimConn = animator.AnimationPlayed:Connect(function(track)
            local id = track.Animation.AnimationId:match("%d+")
            if table.find(dusekAnimIds, id) then
                task.delay(0.5, function() if dusekEnabled then dusekAiming = true end end)
                track.Stopped:Once(function() dusekAiming = false end)
            end
        end)
    end
end

if LocalPlayer.Character then setupDusekChar(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(c) task.delay(1, setupDusekChar, c) end)

RunService.RenderStepped:Connect(function()
    if not dusekEnabled or not dusekAiming or not dusekHumanoid then return end
    local target = getNearestDusekTarget()
    if target then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
    end
end)

