            if mapFolder then
                for _, gen in pairs(mapFolder:GetChildren()) do
                    if gen.Name == "Generator" then createESP(gen, Color3.fromRGB(170, 0, 255)) end
                end
            end
        end
        if ESPState.Items and ItemsFolder then
            for _, item in pairs(ItemsFolder:GetChildren()) do
