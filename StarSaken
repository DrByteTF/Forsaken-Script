-- COMBAT — Chance Aim (Flintlock)
-- ==========================================
local ChanceSec = Combat:Section({ Title = "Chance Aim", Opened = false })

local chanceAimActive = false
local chanceAimPrediction = 2
local chanceAimDuration = 1.6
local chanceAimTargets = {"Slasher","c00lkidd","JohnDoe","1x1x1x1","Noli","Guest 666","Sixer","Nosferatu"}
local chanceMovementThreshold = 0.5
local chanceHumanoid, chanceHRP
local chanceLastTrigger = 0
local chanceAiming = false
local chanceOrigWS, chanceOrigAutoRotate
local chancePrevFlintVisible = false

local function configureChanceChar(char)
    chanceHumanoid = char:FindFirstChild("Humanoid")
    chanceHRP = char:FindFirstChild("HumanoidRootPart")
end

if LocalPlayer.Character then configureChanceChar(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(configureChanceChar)

local function findChanceTarget()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, targetName in ipairs(chanceAimTargets) do
                    if plr.Character.Name:lower():find(targetName:lower()) then
                        return hrp
                    end
                end
            end
        end
    end
    return nil
end

local function isFlintlockVisible()
    if not LocalPlayer.Character then return false end
    local flint = LocalPlayer.Character:FindFirstChild("Flintlock", true)
    if not flint then return false end
    if not flint:IsA("BasePart") then
        flint = flint:FindFirstChildWhichIsA("BasePart", true)
        if not flint then return false end
    end
    return flint.Transparency < 1
end

RunService.RenderStepped:Connect(function()
    if not chanceAimActive or not chanceHumanoid or not chanceHRP then
        if chanceAiming then
            chanceAiming = false
            if chanceOrigWS and chanceOrigAutoRotate ~= nil then
                chanceHumanoid.WalkSpeed = chanceOrigWS
                chanceHumanoid.AutoRotate = chanceOrigAutoRotate
                chanceOrigWS, chanceOrigAutoRotate = nil, nil
            end
        end
        return
    end

    local isVisible = isFlintlockVisible()
    if not chanceAiming and isVisible and not chancePrevFlintVisible then
        chanceLastTrigger = tick()
        chanceAiming = true
        chanceOrigWS = chanceHumanoid.WalkSpeed
        chanceOrigAutoRotate = chanceHumanoid.AutoRotate
    end
    chancePrevFlintVisible = isVisible

    if chanceAiming then
        local elapsed = tick() - chanceLastTrigger
        local targetHRP = findChanceTarget()
        if not targetHRP
            or (targetHRP.Position - chanceHRP.Position).Magnitude < 6
            or elapsed > chanceAimDuration
            or not isVisible then
            chanceAiming = false
            if chanceOrigWS and chanceOrigAutoRotate ~= nil then
                chanceHumanoid.WalkSpeed = chanceOrigWS
                chanceHumanoid.AutoRotate = chanceOrigAutoRotate
                chanceOrigWS, chanceOrigAutoRotate = nil, nil
            end
            return
        end

        chanceHumanoid.AutoRotate = false
        chanceHRP.AssemblyAngularVelocity = Vector3.zero

        local targetPos = targetHRP.Position
        if targetHRP.Velocity.Magnitude > chanceMovementThreshold then
            targetPos = targetPos + (targetHRP.CFrame.LookVector * chanceAimPrediction)
        end
        local dir = (targetPos - chanceHRP.Position).Unit
        local yaw = math.atan2(-dir.X, -dir.Z)
        chanceHRP.CFrame = CFrame.new(chanceHRP.Position) * CFrame.Angles(0, yaw, 0)
    end
end)

ChanceSec:Toggle({ Title = "Auto Aim", Default = false, Callback = function(v) chanceAimActive = v end })
ChanceSec:Input({
    Title = "Aim Prediction",
    Placeholder = "2",
    Value = "2",
    Callback = function(t) local n = tonumber(t); if n then chanceAimPrediction = n end end,
})

