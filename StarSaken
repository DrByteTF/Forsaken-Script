local SlashSec = Combat:Section({ Title = "Auto Slash", Opened = false })

local autoSlash = false
local autoSlashAim = false
local slashRage = 12
local slashCooldown = 30
local lastSlash = 0

local slashTargets = {
    "Slasher","c00lkidd","JohnDoe","1x1x1x1",
    "Noli","Guest 666","Sixer","Nosferatu"
}

local slashHumanoid, slashHRP

local function setupSlashChar(char)
    slashHumanoid = char:WaitForChild("Humanoid", 5)
    slashHRP = char:WaitForChild("HumanoidRootPart", 5)
end

if LocalPlayer.Character then setupSlashChar(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(setupSlashChar)

local function getSlashTarget()
    if not slashHRP then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local h = plr.Character:FindFirstChild("HumanoidRootPart")
            if h and (h.Position - slashHRP.Position).Magnitude <= slashRage then
                for _, n in ipairs(slashTargets) do
                    if plr.Character.Name:lower():find(n:lower()) then
                        return h
                    end
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not slashHumanoid or not slashHRP then return end
    local target = getSlashTarget()
    if not target then return end

    local now = tick()
    local ready = (now - lastSlash) >= slashCooldown

    if autoSlashAim and ready then
        local dir = (target.Position - slashHRP.Position).Unit
        local yaw = math.atan2(-dir.X, -dir.Z)
        slashHRP.CFrame = CFrame.new(slashHRP.Position) * CFrame.Angles(0, yaw, 0)
    end

    if autoSlash and ready then
        lastSlash = now
        pcall(function()
            RemoteEvent:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0Slash") })
        end)
    end
end)

