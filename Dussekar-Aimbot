--[[
    Dusekkar Silent Aim — Full
    ============================================================
    Controls:
    - Aimbot ON/OFF
    - Smoothness
    - Target Team (Killers / Survivors / Auto)
    - FOV Size
    - Show FOV
    - Prediction
]]

-- ============================================================
-- SERVICES
-- ============================================================
local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService  = game:GetService("UserInputService")
local Stats             = game:GetService("Stats")

local LP = Players.LocalPlayer
local PG = LP:WaitForChild("PlayerGui")
local safeUIParent = (type(gethui) == "function" and gethui()) or PG
local Camera = workspace.CurrentCamera

-- ============================================================
-- CONFIG
-- ============================================================
local Config = {
    AimEnabled    = false,
    Smoothness    = 0.15,
    TargetTeam    = "Killers",   -- "Killers" / "Survivors" / "Auto"
    FovRadius     = 250,
    ShowFov       = true,
    Prediction    = 0.12,
    ProjectileSpeed = 950,
    VerticalOffset = 0.8,
}

-- ============================================================
-- STATE
-- ============================================================
local State = {
    RemoteFunction   = nil,
    OriginalCallback = nil,
    LastAimPos       = nil,
    CurrentTarget    = nil,
}

-- ============================================================
-- FOV CIRCLE (Drawing API)
-- ============================================================
local FovCircle = Drawing.new("Circle")
FovCircle.Thickness     = 1.5
FovCircle.NumSides      = 100
FovCircle.Filled        = false
FovCircle.Transparency  = 1
FovCircle.Color         = Color3.new(1, 1, 1)
FovCircle.Visible       = false

-- ============================================================
-- HELPERS
-- ============================================================
local function getLatency()
    local ok, ping = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    return ok and ping or 0.05
end

local function isProtected()
    local char = LP.Character
    if not char then return true end
    if char:GetAttribute("SpawnProtection") then return true end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp.Transparency > 0.1 then return true end
    return false
end

-- ============================================================
-- TARGET SELECTION (with FOV + team filter)
-- ============================================================
local function getBestTarget()
    if isProtected() then return nil end
    local pf = workspace:FindFirstChild("Players")
    if not pf then return nil end

    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    -- Determine which folders to scan
    local folders = {}
    if Config.TargetTeam == "Auto" then
        local kf = pf:FindFirstChild("Killers")
        local sf = pf:FindFirstChild("Survivors")
        if kf then table.insert(folders, kf) end
        if sf then table.insert(folders, sf) end
    else
        local f = pf:FindFirstChild(Config.TargetTeam)
        if f then table.insert(folders, f) end
    end

    local mouseLoc = UserInputService:GetMouseLocation()
    local bestTarget, bestScore = nil, math.huge

    for _, folder in ipairs(folders) do
        for _, char in ipairs(folder:GetChildren()) do
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 and char ~= LP.Character then
                local screenPos, visible = Camera:WorldToViewportPoint(root.Position)
                if visible then
                    local dx = screenPos.X - mouseLoc.X
                    local dy = screenPos.Y - mouseLoc.Y
                    local screenDist = math.sqrt(dx*dx + dy*dy)

                    if screenDist <= Config.FovRadius then
                        -- Score by screen distance (closest to crosshair wins)
                        -- For "Auto" mode, this naturally picks the closest to aim
                        if screenDist < bestScore then
                            bestScore = screenDist
                            bestTarget = root
                        end
                    end
                end
            end
        end
    end

    return bestTarget
end

-- ============================================================
-- PREDICTION + SMOOTHING
-- ============================================================
local function calculateAimPosition(targetPart)
    local currentPos = targetPart.Position
    local velocity = targetPart.AssemblyLinearVelocity
    local distance = (currentPos - Camera.CFrame.Position).Magnitude

    local timeToHit = distance / Config.ProjectileSpeed
    timeToHit = timeToHit + getLatency()

    local predicted = currentPos
        + velocity * timeToHit * (Config.Prediction * 10)
        + Vector3.new(0, Config.VerticalOffset, 0)

    if not State.LastAimPos then
        State.LastAimPos = predicted
    else
        local alpha = 1 - Config.Smoothness
        State.LastAimPos = State.LastAimPos:Lerp(predicted, math.clamp(alpha, 0.02, 1))
    end
    return State.LastAimPos
end

-- ============================================================
-- SILENT AIM HOOK
-- ============================================================
local function applySilentAim()
    if State.RemoteFunction then return end

    local ok, remote = pcall(function()
        return ReplicatedStorage:WaitForChild("Modules", 5)
            :WaitForChild("Network", 5)
            :WaitForChild("Network", 5)
            :WaitForChild("RemoteFunction", 5)
    end)
    if not ok or not remote then
        warn("[Dusekkar Aim] RemoteFunction not found")
        return
    end

    State.RemoteFunction = remote

    if typeof(getcallbackvalue) == "function" then
        pcall(function()
            State.OriginalCallback = getcallbackvalue(remote, "OnClientInvoke")
        end)
    end

    remote.OnClientInvoke = function(requestName, ...)
        if requestName == "GetMousePosition" and Config.AimEnabled and not isProtected() then
            local target = getBestTarget()
            State.CurrentTarget = target
            if target then
                return calculateAimPosition(target)
            end
        end
        if State.OriginalCallback then
            return State.OriginalCallback(requestName, ...)
        end
    end
end

local function resetSmoothing()
    State.LastAimPos = nil
end

-- ============================================================
-- FOV UPDATE LOOP
-- ============================================================
RunService.RenderStepped:Connect(function()
    local mouseLoc = UserInputService:GetMouseLocation()
    FovCircle.Position = Vector2.new(mouseLoc.X, mouseLoc.Y)
    FovCircle.Radius = Config.FovRadius
    FovCircle.Visible = Config.ShowFov

    -- Color coding: shows status at a glance
    if not Config.AimEnabled then
        FovCircle.Color = Color3.fromRGB(100, 100, 100)    -- grey = off
    elseif isProtected() then
        FovCircle.Color = Color3.fromRGB(255, 50, 50)      -- red = protected
    elseif State.CurrentTarget then
        FovCircle.Color = Color3.fromRGB(0, 255, 150)      -- green = target locked
    else
        FovCircle.Color = Color3.new(1, 1, 1)              -- white = idle
    end
end)

-- ============================================================
-- UI
-- ============================================================
local T = {
    bg = Color3.fromRGB(18, 18, 22),
    panel = Color3.fromRGB(28, 28, 34),
    accent = Color3.fromRGB(180, 100, 255),
    text = Color3.fromRGB(240, 240, 248),
    subtext = Color3.fromRGB(150, 150, 168),
    border = Color3.fromRGB(48, 48, 58),
    on = Color3.fromRGB(65, 185, 100),
    off = Color3.fromRGB(190, 60, 60),
}

local function mk(cls, prp, prnt)
    local o = Instance.new(cls)
    for k, v in pairs(prp or {}) do o[k] = v end
    if prnt then o.Parent = prnt end
    return o
end

local function corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 6)
    c.Parent = p
end

local function stroke(p)
    local s = Instance.new("UIStroke")
    s.Color = T.border
    s.Thickness = 1
    s.Parent = p
end

local screen = mk("ScreenGui", {
    Name = "DusekkarAim", ResetOnSpawn = false, IgnoreGuiInset = true,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, safeUIParent)

local main = mk("Frame", {
    Size = UDim2.new(0, 280, 0, 320),
    Position = UDim2.new(0, 20, 0.5, -160),
    BackgroundColor3 = T.bg, BorderSizePixel = 0, Active = true,
}, screen)
corner(main, 10); stroke(main)

-- Title bar
