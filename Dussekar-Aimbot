-- Drag
local dragging, dragStart, startPos
tb.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)

-- Content
local content = mk("ScrollingFrame", {
    Size = UDim2.new(1, -16, 1, -46), Position = UDim2.new(0, 8, 0, 40),
    BackgroundTransparency = 1, BorderSizePixel = 0,
    ScrollBarThickness = 3, ScrollBarImageColor3 = T.accent,
    AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, main)
mk("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, content)

-- ============================================================
-- BUILDERS
-- ============================================================
local function addToggle(label, key, cb)
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = T.panel, BorderSizePixel = 0,
    }, content)
    corner(row, 6); stroke(row)
    mk("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1, Text = label,
        Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = T.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local pill = mk("TextButton", {
        Size = UDim2.new(0, 46, 0, 20), Position = UDim2.new(1, -56, 0.5, -10),
        BackgroundColor3 = Config[key] and T.on or T.off,
        Text = Config[key] and "ON" or "OFF",
        Font = Enum.Font.GothamBold, TextSize = 9, TextColor3 = T.text,
        BorderSizePixel = 0,
    }, row)
    corner(pill, 10)
    pill.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        pill.BackgroundColor3 = Config[key] and T.on or T.off
        pill.Text = Config[key] and "ON" or "OFF"
        if cb then cb(Config[key]) end
    end)
end

local function addSlider(label, key, min, max, cb)
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = T.panel, BorderSizePixel = 0,
    }, content)
    corner(row, 6); stroke(row)
    local lbl = mk("TextLabel", {
        Size = UDim2.new(1, -16, 0, 14), Position = UDim2.new(0, 10, 0, 4),
        BackgroundTransparency = 1, Text = label .. ": " .. tostring(Config[key]),
        Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = T.subtext,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local track = mk("Frame", {
        Size = UDim2.new(1, -20, 0, 5), Position = UDim2.new(0, 10, 0, 26),
        BackgroundColor3 = T.border, BorderSizePixel = 0,
    }, row)
    corner(track, 3)
    local fill = mk("Frame", {
        Size = UDim2.new((Config[key] - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = T.accent, BorderSizePixel = 0,
    }, track)
    corner(fill, 3)
    local drag = false
    local function update(input)
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + rel * (max - min) + 0.5)
        val = math.clamp(val, min, max)
        Config[key] = val
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = label .. ": " .. val
        if cb then cb(val) end
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            drag = true; update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if drag and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
end

local function addDropdown(label, key, options, cb)
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = T.panel, BorderSizePixel = 0,
    }, content)
    corner(row, 6); stroke(row)
    mk("TextLabel", {
        Size = UDim2.new(1, -16, 0, 14), Position = UDim2.new(0, 10, 0, 4),
        BackgroundTransparency = 1, Text = label,
        Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = T.subtext,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local btn = mk("TextButton", {
        Size = UDim2.new(1, -20, 0, 22), Position = UDim2.new(0, 10, 0, 20),
        BackgroundColor3 = T.bg, Text = "  " .. tostring(Config[key]) .. "  ▾",
        Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = T.text,
        BorderSizePixel = 0, TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    corner(btn, 4); stroke(btn)
    local idx = 1
    for i, v in ipairs(options) do if v == Config[key] then idx = i end end
    btn.MouseButton1Click:Connect(function()
        idx = idx % #options + 1
        Config[key] = options[idx]
        btn.Text = "  " .. options[idx] .. "  ▾"
        if cb then cb(options[idx]) end
    end)
end

-- ============================================================
-- POPULATE
-- ============================================================
addToggle("Aimbot", "AimEnabled", function(v)
    if v then
        applySilentAim()
        resetSmoothing()
    end
end)

addSlider("Smoothness", "Smoothness", 0, 100, function(v)
    Config.Smoothness = v / 100
end)
-- Fix initial value for smoothness (stored as 0-1, slider expects 0-100)
Config.Smoothness = 0.15

addDropdown("Target Team", "TargetTeam", {"Killers", "Survivors", "Auto"})

addSlider("FOV Size", "FovRadius", 50, 800)

addToggle("Show FOV", "ShowFov")

addSlider("Prediction ×100", "Prediction", 0, 50, function(v)
    Config.Prediction = v / 100
end)

-- Keybind
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        main.Visible = not main.Visible
    end
end)

