    BackgroundColor3 = T.off, Text = "X",
    Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = T.text,
    BorderSizePixel = 0,
}, tb)
corner(closeBtn, 4)
closeBtn.MouseButton1Click:Connect(function()
    if State.RemoteFunction and State.OriginalCallback then
