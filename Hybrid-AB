-- ==========================================
-- Helpers
-- ==========================================
local function getKillersFolder()
    local p = Workspace:FindFirstChild("Players")
    return p and p:FindFirstChild("Killers")
end

local function fireBlock()
    if not RemoteEvent then return end
    pcall(function()
        RemoteEvent:FireServer("UseActorAbility", {[1] = buffer.fromstring("\3\5\0\0\0Block")})
    end)
end

local function firePunch()
    if not RemoteEvent then return end
    pcall(function()
        RemoteEvent:FireServer("UseActorAbility", {[1] = buffer.fromstring("\3\5\0\0\0Punch")})
    end)
end

local function isFacing(myRoot, targetRoot, killerName)
    if not Config.VerifyFacing then return true end
    if not myRoot or not targetRoot then return false end
    local diff = myRoot.Position - targetRoot.Position
    if diff.Magnitude < 0.01 then return true end
    local dir = diff.Unit
    local dot = targetRoot.CFrame.LookVector:Dot(dir)
    return dot > Config.FacingDot
end

local function cacheHRP(char)
    cachedHRP = char and char:FindFirstChild("HumanoidRootPart")
end
if LocalPlayer.Character then cacheHRP(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(cacheHRP)

local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function isBlockReady()
    local ui = LocalPlayer:FindFirstChild("PlayerGui")
    if ui then
        local m = ui:FindFirstChild("MainUI")
        if m then
            local ac = m:FindFirstChild("AbilityContainer")
            if ac then
                local bl = ac:FindFirstChild("Block")
                if bl then
                    local ct = bl:FindFirstChild("CooldownTime")
                    if ct and ct:IsA("TextLabel") then
                        local num = ct.Text:match("[%d%.]+")
                        if num then
                            local v = tonumber(num)
                            return not v or v <= 0
                        end
                        return true
                    end
                end
            end
        end
    end
    return tick() - blockLastTime >= Config.BlockCooldown
end

local function attemptBlock(killerModel, distance)
    if not Config.AutoBlockOn then return end
    if not isBlockReady() then return end
    if distance > Config.DetectionRange then return end

    local root = getRoot()
    if not root then return end

    local hrp = killerModel:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not isFacing(root, hrp, killerModel.Name) then return end

    if Config.BlockDelay > 0 then task.wait(Config.BlockDelay) end

    fireBlock()
    blockLastTime = tick()

    if Config.AutoPunchOn then
        task.delay(Config.AutoPunchDelay, firePunch)
    end
end

-- ==========================================
-- Animation Auto-Block (Guesting Hub style)
-- ==========================================
local function setupAnimBlock()
    if animBlockConn then animBlockConn:Disconnect(); animBlockConn = nil end
    if not Config.AnimEnabled then return end

    animBlockConn = RunService.Heartbeat:Connect(function()
        if not Config.AnimEnabled or not Config.AutoBlockOn then return end
        local myRoot = cachedHRP
        if not myRoot then return end
        local kf = getKillersFolder()
        if not kf then return end

        for _, killer in ipairs(kf:GetChildren()) do
            local khrp = killer:FindFirstChild("HumanoidRootPart")
            local khum = killer:FindFirstChildOfClass("Humanoid")
            if not khrp or not khum then continue end

            local dist = (khrp.Position - myRoot.Position).Magnitude
            if dist > Config.AnimRange then continue end
            if not isFacing(myRoot, khrp, killer.Name) then continue end

            local anim = khum:FindFirstChildOfClass("Animator")
            if not anim then continue end

            local ok, tracks = pcall(function() return anim:GetPlayingAnimationTracks() end)
            if not ok then continue end

            for _, track in ipairs(tracks) do
                local animId
                pcall(function()
                    animId = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
                end)
                if animId and TRIGGER_ANIMS[animId] then
                    local now = tick()
                    if now - blockLastTime >= BLOCK_CD then
                        blockLastTime = now
                        local function doBlock()
                            fireBlock()
                            if Config.DoubleBlock then
                                task.wait(0.05)
                                firePunch()
                            end
                        end
                        if Config.AnimBlockDelay > 0 then
                            task.delay(Config.AnimBlockDelay, doBlock)
                        else
                            doBlock()
                        end
                    end
                    break
                end
            end
        end
    end)
end

-- ==========================================
-- Sound Auto-Block (Guesting Hub style)
-- ==========================================
local function hookSound(sound)
    if not sound or not sound:IsA("Sound") or hookedSounds[sound] then return end
    local preId = tostring(sound.SoundId):match("%d+")
    if not preId or not TRIGGER_SOUNDS[preId] then return end

    local pc = sound.Played:Connect(function()
        if Config.AutoBlockOn and Config.BlockMode ~= "Animation" and Config.BlockMode ~= "Hitbox" then
            local now = tick()
            if soundBlockedUntil[sound] and now < soundBlockedUntil[sound] then return end

            local root = getRoot()
            if not root then return end

            local soundPart = sound.Parent
            if not soundPart or not soundPart:IsA("BasePart") then
                local att = sound.Parent
                if att and att:IsA("Attachment") then soundPart = att.Parent end
            end
            if not soundPart then return end

            local killer = soundPart:FindFirstAncestorOfClass("Model")
            if not killer then return end
            local hrp = killer:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local dist = (hrp.Position - root.Position).Magnitude
            if dist > Config.DetectionRange then return end
            if not isFacing(root, hrp, killer.Name) then return end

            fireBlock()
            blockLastTime = tick()

            if Config.AutoPunchOn then
                task.delay(Config.AutoPunchDelay, firePunch)
            end
            soundBlockedUntil[sound] = tick() + 0.5
        end
    end)

    local pp = sound:GetPropertyChangedSignal("IsPlaying"):Connect(function()
        if sound.IsPlaying and Config.AutoBlockOn and Config.BlockMode ~= "Animation" and Config.BlockMode ~= "Hitbox" then
            -- Same logic as above
            local now = tick()
            if soundBlockedUntil[sound] and now < soundBlockedUntil[sound] then return end
            -- ... (same as above)
        end
    end)

    local dc
    dc = sound.Destroying:Connect(function()
        pcall(function() pc:Disconnect(); pp:Disconnect(); dc:Disconnect() end)
        hookedSounds[sound] = nil
        soundBlockedUntil[sound] = nil
    end)

    hookedSounds[sound] = {pc, pp, dc}
end

-- Hook existing and future sounds in Killers folder
task.spawn(function()
    local pf = Workspace:FindFirstChild("Players")
    if not pf then pf = Workspace:WaitForChild("Players", 30) end
    if not pf then return end
    local kf = pf:FindFirstChild("Killers")
    if not kf then kf = pf:WaitForChild("Killers", 30) end
    if not kf then return end

    for _, killer in pairs(kf:GetChildren()) do
        for _, d in pairs(killer:GetDescendants()) do
            if d:IsA("Sound") then pcall(hookSound, d) end
        end
    end
    kf.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then pcall(hookSound, d) end
    end)
end)

-- ==========================================
-- Hitbox Auto-Block (Fartsaken-style predictive)
-- ==========================================
local function tryBlockFromHitbox(hb)
    if not Config.HitboxEnabled or not Config.AutoBlockOn then return end
    if not hb or not hb:IsA("BasePart") then return end
    local sz = hb.Size
    if math.abs(sz.X - Config.HitboxSize.X) > Config.HitboxMargin
    or math.abs(sz.Y - Config.HitboxSize.Y) > Config.HitboxMargin
    or math.abs(sz.Z - Config.HitboxSize.Z) > Config.HitboxMargin then return end

    local kf = getKillersFolder()
    if not kf then return end
    local killerModel = nil
    for _, km in ipairs(kf:GetChildren()) do
        if hb.Name == km.Name or hb.Name:sub(1, #km.Name) == km.Name then
            killerModel = km
            break
        end
    end
    if not killerModel then return end

    local myRoot = cachedHRP
    if not myRoot then return end
    local dist = (hb.Position - myRoot.Position).Magnitude
    if dist > Config.HitboxRange then return end

    local hrp = killerModel:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not isFacing(myRoot, hrp, killerModel.Name) then return end

    local now = tick()
    if now - blockLastTime < BLOCK_CD then return end
    blockLastTime = now

    local function doBlock()
        fireBlock()
        if Config.DoubleBlock then
            task.wait(0.05)
            firePunch()
        end
    end
    if Config.AnimBlockDelay > 0 then
        task.delay(Config.AnimBlockDelay, doBlock)
    else
        doBlock()
    end
end

local function setupHitboxBlock()
    if hitboxConn then hitboxConn:Disconnect(); hitboxConn = nil end
    if hitboxHeartbeat then hitboxHeartbeat:Disconnect(); hitboxHeartbeat = nil end
    if not Config.HitboxEnabled or not Config.AutoBlockOn then return end

    local folder = Workspace:FindFirstChild("Hitboxes")
    if not folder then
        folder = Workspace:WaitForChild("Hitboxes", 10)
        if not folder then return end
    end

    for _, hb in ipairs(folder:GetChildren()) do
        task.spawn(tryBlockFromHitbox, hb)
    end
    hitboxConn = folder.ChildAdded:Connect(tryBlockFromHitbox)

    hitboxHeartbeat = RunService.Heartbeat:Connect(function()
        if not Config.HitboxEnabled or not Config.AutoBlockOn then return end
        if not folder or not folder.Parent then return end
        local myRoot = cachedHRP
        if not myRoot then return end

        for _, hb in ipairs(folder:GetChildren()) do
            if hb:IsA("BasePart") then
                local sz = hb.Size
                if math.abs(sz.X - Config.HitboxSize.X) <= Config.HitboxMargin
                and math.abs(sz.Y - Config.HitboxSize.Y) <= Config.HitboxMargin
                and math.abs(sz.Z - Config.HitboxSize.Z) <= Config.HitboxMargin then
                    local dist = (hb.Position - myRoot.Position).Magnitude
                    if dist <= Config.HitboxRange then
                        local now = tick()
                        if now - blockLastTime >= BLOCK_CD then
                            blockLastTime = now
                            local function doBlock()
                                fireBlock()
                                if Config.DoubleBlock then
                                    task.wait(0.05)
                                    firePunch()
                                end
                            end
                            if Config.AnimBlockDelay > 0 then
                                task.delay(Config.AnimBlockDelay, doBlock)
                            else
                                doBlock()
                            end
                        end
                    end
                end
            end
        end
    end)
end

