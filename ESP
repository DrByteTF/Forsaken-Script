-- ==========================================
-- Helper: Get folders
-- ==========================================
local function getKillerFolder()
    local players = Workspace:FindFirstChild("Players")
    if players then
        return players:FindFirstChild("Killers")
    end
    return nil
end

local function getSurvivorFolder()
    local players = Workspace:FindFirstChild("Players")
    if players then
        return players:FindFirstChild("Survivors")
    end
    return nil
end

local function getGeneratorFolder()
    return Workspace:FindFirstChild("Generators")
end

local function getItemFolder()
    return Workspace:FindFirstChild("Items")
end

-- ==========================================
-- ESP Creation
-- ==========================================
local function createESP(instance, espType)
    if espObjects[instance] then return end
    if not instance:IsA("Model") then return end

    local hrp = instance:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local humanoid = instance:FindFirstChildOfClass("Humanoid")

    -- Determine color
    local color, showName, showDist, showHealth
    if espType == "Killer" then
        color = Config.KillerColor
        showName = Config.KillerShowName
        showDist = Config.KillerShowDistance
        showHealth = Config.KillerShowHealth
    elseif espType == "Survivor" then
        color = Config.SurvivorColor
        showName = Config.SurvivorShowName
        showDist = Config.SurvivorShowDistance
        showHealth = Config.SurvivorShowHealth
    elseif espType == "Generator" then
        color = Config.GeneratorColor
        showName = false
        showDist = Config.GeneratorShowDistance
        showHealth = false
    elseif espType == "Item" then
        color = Config.ItemColor
        showName = false
        showDist = Config.ItemShowDistance
        showHealth = false
    else
        return
    end

    -- Highlight
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = color
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = Config.Transparency
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = instance
    highlight.Parent = instance

    -- Billboard
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Billboard"
    billboard.Size = UDim2.new(0, 150, 0, 50)
    billboard.AlwaysOnTop = true
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Adornee = hrp
    billboard.Parent = instance

    local label = Instance.new("TextLabel")
    label.Name = "ESP_Label"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Text = instance.Name
    label.Parent = billboard

    espObjects[instance] = {
        highlight = highlight,
        billboard = billboard,
        label = label,
        type = espType,
        showName = showName,
        showDist = showDist,
        showHealth = showHealth,
    }
end

-- ==========================================
-- ESP Removal
-- ==========================================
local function removeESP(instance)
    local data = espObjects[instance]
    if data then
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
        espObjects[instance] = nil
    end
end

-- ==========================================
-- ESP Refresh
-- ==========================================
local function refreshESP()
    -- Clear all
    for instance, _ in pairs(espObjects) do
        removeESP(instance)
    end

    if not Config.ESPEnabled then return end

    -- Killers
    if Config.KillerEnabled then
        killerFolder = getKillerFolder()
        if killerFolder then
            for _, killer in ipairs(killerFolder:GetChildren()) do
                createESP(killer, "Killer")
            end
        end
    end

    -- Survivors
    if Config.SurvivorEnabled then
        survivorFolder = getSurvivorFolder()
        if survivorFolder then
            for _, survivor in ipairs(survivorFolder:GetChildren()) do
                createESP(survivor, "Survivor")
            end
        end
    end

    -- Generators
    if Config.GeneratorEnabled then
        generatorFolder = getGeneratorFolder()
        if generatorFolder then
            for _, gen in ipairs(generatorFolder:GetChildren()) do
                createESP(gen, "Generator")
            end
        end
    end

    -- Items
    if Config.ItemEnabled then
        itemFolder = getItemFolder()
        if itemFolder then
            for _, item in ipairs(itemFolder:GetChildren()) do
                createESP(item, "Item")
            end
        end
    end
end

-- ==========================================
-- Update Loop
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not Config.ESPEnabled then return end

    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for instance, data in pairs(espObjects) do
        if not instance.Parent then
            removeESP(instance)
            continue
        end

        local hrp = instance:FindFirstChild("HumanoidRootPart")
        if not hrp then
            removeESP(instance)
            continue
        end

        -- Distance check
        if myHRP then
            local dist = (hrp.Position - myHRP.Position).Magnitude
            if dist > Config.MaxDistance then
                if data.highlight then data.highlight.Enabled = false end
                if data.billboard then data.billboard.Enabled = false end
                continue
            else
                if data.highlight then data.highlight.Enabled = true end
                if data.billboard then data.billboard.Enabled = true end
            end

            -- Build label text
            local parts = {}
            if data.showName then
                table.insert(parts, instance.Name)
            end
            if data.showHealth and instance:FindFirstChildOfClass("Humanoid") then
                local hum = instance:FindFirstChildOfClass("Humanoid")
                table.insert(parts, "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth))
            end
            if data.showDist then
                table.insert(parts, "[" .. math.floor(dist) .. "]")
            end
            data.label.Text = table.concat(parts, "\n")
        end
    end
end)

-- ==========================================
-- Folder Watchers
-- ==========================================
local function watchFolder(folder, espType)
    if not folder then return end
    folder.ChildAdded:Connect(function(child)
        if Config.ESPEnabled then
            task.wait(0.1)  -- wait for HRP
            createESP(child, espType)
        end
    end)
    folder.ChildRemoved:Connect(function(child)
        removeESP(child)
    end)
end

-- Initial setup
killerFolder = getKillerFolder()
survivorFolder = getSurvivorFolder()
generatorFolder = getGeneratorFolder()
itemFolder = getItemFolder()

if killerFolder then watchFolder(killerFolder, "Killer") end
if survivorFolder then watchFolder(survivorFolder, "Survivor") end
if generatorFolder then watchFolder(generatorFolder, "Generator") end
if itemFolder then watchFolder(itemFolder, "Item") end

-- Re-watch when folders change (e.g., new round)
Workspace.DescendantAdded:Connect(function(desc)
    if desc.Name == "Killers" or desc.Name == "Survivors" or desc.Name == "Generators" or desc.Name == "Items" then
        task.wait(0.5)
        if desc.Name == "Killers" then killerFolder = desc; watchFolder(desc, "Killer") end
        if desc.Name == "Survivors" then survivorFolder = desc; watchFolder(desc, "Survivor") end
        if desc.Name == "Generators" then generatorFolder = desc; watchFolder(desc, "Generator") end
        if desc.Name == "Items" then itemFolder = desc; watchFolder(desc, "Item") end
        refreshESP()
    end
end)

