--[[
    Chance One Shot Aimbot — WindUI Edition (Mobile Friendly)
    Locks aim onto the nearest killer and fires One Shot with a chance slider.
    WARNING: Violates Roblox ToS. Use at your own risk.
]]

-- ==========================================
-- Load WindUI
-- ==========================================
local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

-- ==========================================
-- Services
-- ==========================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- Remote
local RemoteEvent
pcall(function()
    RemoteEvent = ReplicatedStorage:WaitForChild("Modules", 10)
        :WaitForChild("Network", 10)
        :WaitForChild("Network", 10)
        :WaitForChild("RemoteEvent", 10)
end)

-- ==========================================
-- Config
-- ==========================================
local Config = {
    AimbotEnabled = true,
    MaxRange = 60,
    Prediction = 0.15,
    FacingThreshold = 0.3,
    AimSpeed = 0.25,
    -- Chance system
    UseChance = true,
    ChancePercent = 50, -- 50% chance to fire when conditions are met
    -- One Shot specific
    OneShotCooldown = 40, -- Ability cooldown (seconds)
}

local lastShotTime = 0
local aimTarget = nil

-- ==========================================
-- Helpers
-- ==========================================
local function getKillersFolder()
    local p = workspace:FindFirstChild("Players")
    return p and p:FindFirstChild("Killers")
end

local function fireOneShot()
    if not RemoteEvent then return end
    -- Buffer format for One Shot (adjust if needed)
    local buf = buffer.fromstring("\3\5\0\0\0One Shot")
    pcall(function()
        RemoteEvent:FireServer("UseActorAbility", {[1] = buf})
    end)
end

local function getNearestKiller()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local kf = getKillersFolder()
    if not kf then return nil end

    local nearest, nearestDist = nil, Config.MaxRange
    for _, killer in ipairs(kf:GetChildren()) do
        local kRoot = killer:FindFirstChild("HumanoidRootPart")
        if kRoot then
            local dist = (kRoot.Position - myRoot.Position).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = kRoot
            end
        end
    end
    return nearest
end

-- Chance roll
local function rollChance()
    if not Config.UseChance then return true end
    local roll = math.random(1, 100)
    return roll <= Config.ChancePercent
end

-- ==========================================
-- Aimbot + One Shot Logic
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not Config.AimbotEnabled then return end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    -- Find target
    local target = getNearestKiller()
    if not target then
        aimTarget = nil
        return
    end

    -- Prediction
    local vel = target.AssemblyLinearVelocity
    local predictedPos = target.Position + (vel * Config.Prediction)

    -- Direction to target
    local dir = (predictedPos - myRoot.Position)
    if dir.Magnitude > 0.1 then
        dir = dir.Unit

        -- Facing check (dot product)
        local facing = myRoot.CFrame.LookVector
        local dot = facing:Dot(dir)

        if dot >= Config.FacingThreshold then
            -- Smoothly rotate character toward target
            local targetCFrame = CFrame.new(myRoot.Position, myRoot.Position + dir)
            myRoot.CFrame = myRoot.CFrame:Lerp(targetCFrame, Config.AimSpeed)

            -- Check cooldown
            if tick() - lastShotTime < Config.OneShotCooldown then return end

            -- Chance roll
            if rollChance() then
                fireOneShot()
                lastShotTime = tick()
            end
        end
    end
end)

-- ==========================================
-- WINDUI
-- ==========================================
local Window = WindUI:CreateWindow({
    Title = "Chance Aimbot",
    Icon = "crosshair",
    Author = "By Xuzi",
    Folder = "ChanceAimbot",
    Size = UDim2.fromOffset(450, 450),
    Transparent = true,
    Theme = "Dark",
    SideBarWidth = 140,
    HideSearchBar = true,
    ScrollBarEnabled = false,
})

local MainTab = Window:Tab({ Title = "Aimbot", Icon = "crosshair" })
local Sec = MainTab:Section({ Title = "One Shot Aimbot", Opened = true })

Sec:Toggle({
    Title = "Enable Aimbot",
    Desc = "Locks onto nearest killer",
    Default = Config.AimbotEnabled,
    Callback = function(v) Config.AimbotEnabled = v end,
})

Sec:Slider({
    Title = "Max Range",
    Desc = "Detection range for killers",
    Step = 5,
    Value = { Min = 10, Max = 120, Default = Config.MaxRange },
    Callback = function(v) Config.MaxRange = v end,
})

Sec:Slider({
    Title = "Prediction",
    Desc = "Aim ahead of moving killers",
    Step = 0.01,
    Value = { Min = 0, Max = 0.5, Default = Config.Prediction },
    Callback = function(v) Config.Prediction = v end,
})

Sec:Slider({
    Title = "Aim Speed",
    Desc = "How fast your character turns",
    Step = 0.05,
    Value = { Min = 0.05, Max = 1, Default = Config.AimSpeed },
    Callback = function(v) Config.AimSpeed = v end,
})

Sec:Slider({
    Title = "Facing Threshold",
    Desc = "Lower = wider arc (0.3 = 140°)",
    Step = 0.05,
    Value = { Min = 0, Max = 1, Default = Config.FacingThreshold },
    Callback = function(v) Config.FacingThreshold = v end,
})

-- Chance section
local ChanceSec = MainTab:Section({ Title = "Chance System", Opened = true })

ChanceSec:Toggle({
    Title = "Enable Chance",
    Desc = "When OFF, always fires. ON uses % below.",
    Default = Config.UseChance,
    Callback = function(v) Config.UseChance = v end,
})

ChanceSec:Slider({
    Title = "Fire Chance (%)",
    Desc = "50% = fires half the time. Lower = more human.",
    Step = 5,
    Value = { Min = 1, Max = 100, Default = Config.ChancePercent },
    Callback = function(v) Config.ChancePercent = v end,
})

ChanceSec:Slider({
    Title = "One Shot Cooldown (s)",
    Desc = "Ability cooldown (default 40s)",
    Step = 1,
    Value = { Min = 30, Max = 60, Default = Config.OneShotCooldown },
    Callback = function(v) Config.OneShotCooldown = v end,
})

ChanceSec:Label({
    Title = "💡 Recommended",
    Desc = "50% chance, 60 range, 0.15 prediction",
})

print("[Chance One Shot Aimbot] Loaded.")
