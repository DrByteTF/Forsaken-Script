--[[
    Hitbox Drag Tech (HDT)
    ============================================================
    Triggers when YOU block (or an auto-block fires).
    Uses block button hook instead of animation watching.
]]

-- ============================================================
-- SERVICES
-- ============================================================
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LP = Players.LocalPlayer
local PG = LP:WaitForChild("PlayerGui")

-- ============================================================
-- CONFIG
-- ============================================================
local Config = {
    Enabled      = false,
    DragSpeed    = 5.6,   -- studs per second toward killer
    DragDuration = 0.4,   -- max seconds the drag lasts
}

-- ============================================================
-- STATE
-- ============================================================
local State = {
    active     = false,
    savedWalk  = nil,
    savedJump  = nil,
    savedStand = nil,
    blockBtn   = nil,
    hooked     = false,
}

-- ============================================================
-- HELPERS
-- ============================================================
local function getMyChar() return LP.Character end
local function getMyRoot()
    local c = getMyChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getMyHum()
    local c = getMyChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getKillersFolder()
    local pf = workspace:FindFirstChild("Players")
    return pf and pf:FindFirstChild("Killers")
end

local function getNearestKiller()
    local myRoot = getMyRoot()
    if not myRoot then return nil end
    local KF = getKillersFolder()
    if not KF then return nil end

    local best, bestDist = nil, math.huge
    for _, k in ipairs(KF:GetChildren()) do
        if k:IsA("Model") then
            local hrp = k:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestDist then
                    best, bestDist = k, d
                end
            end
        end
    end
    return best
end

local function getBlockButton()
    local main = PG:FindFirstChild("MainUI")
    local cont = main and main:FindFirstChild("AbilityContainer")
    return cont and cont:FindFirstChild("Block")
end

-- ============================================================
-- DRAG LOGIC
-- ============================================================
local function beginDrag(killer)
    if State.active then return end
    if not killer or not killer.Parent then return end

    local char = getMyChar()
    local hrp = getMyRoot()
    local hum = getMyHum()
    if not char or not hrp or not hum then return end

    local target = killer:FindFirstChild("HumanoidRootPart") or killer.PrimaryPart
    if not target then return end

    -- Mark active + save state
    State.active = true
    State.savedWalk  = hum.WalkSpeed
    State.savedJump  = hum.JumpPower
    State.savedStand = hum.PlatformStand

    -- Freeze normal movement
    hum.WalkSpeed = 0
    hum.JumpPower = 0
    hum.PlatformStand = false

    -- Push toward killer with BodyVelocity
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 0, 1e5)  -- horizontal only
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local startTime = tick()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        -- Stop conditions: disabled, timed out, char/killer gone
        local elapsed = tick() - startTime
        if not State.active
            or elapsed > Config.DragDuration
            or not char.Parent
            or not killer.Parent then
            State.active = false
            return
        end

        local currentRoot = getMyRoot()
        local currentTarget = killer:FindFirstChild("HumanoidRootPart") or killer.PrimaryPart
        if not currentRoot or not currentTarget then
            State.active = false
            return
        end

        -- Push horizontally toward killer
        local diff = currentTarget.Position - currentRoot.Position
        local flat = Vector3.new(diff.X, 0, diff.Z)
        if flat.Magnitude > 0.01 then
            bv.Velocity = flat.Unit * Config.DragSpeed
        else
            bv.Velocity = Vector3.zero
        end
    end)

    -- Cleanup when drag ends
    task.spawn(function()
        local start = tick()
        while State.active and tick() - start < Config.DragDuration + 0.1 do
            task.wait(0.05)
        end

        if conn then conn:Disconnect() end
        if bv and bv.Parent then bv:Destroy() end

        local h = getMyHum()
        if h then
            h.WalkSpeed  = State.savedWalk  or 16
            h.JumpPower  = State.savedJump  or 50
            h.PlatformStand = State.savedStand or false
        end
        State.active = false
    end)
end

-- ============================================================
-- HOOK THE BLOCK BUTTON
-- ============================================================
-- Fires when the block is triggered — whether manually, by auto-block,
-- or by firesignal. Uses getconnections to attach to existing listeners.
local lastTrigger = 0

local function tryHookBlockButton()
    local btn = getBlockButton()
    if not btn or btn == State.blockBtn then return end
    State.blockBtn = btn

    if type(getconnections) ~= "function" then
        warn("[HDT] getconnections not available — falling back to input method")
        return
    end

    local ok, conns = pcall(function() return getconnections(btn.MouseButton1Click) end)
    if not ok or not conns then return end

    for _, conn in ipairs(conns) do
        local oldFunc = conn.Function
        conn:Disable()
        conn = nil
        break
    end

    -- Alternative approach: since some executors struggle with hooking
    -- already-connected signals, we use a separate listener that fires
    -- our drag alongside the normal block
    local newConn = btn.MouseButton1Click:Connect(function()
        if not Config.Enabled then return end
        if tick() - lastTrigger < 0.3 then return end
        lastTrigger = tick()

        local killer = getNearestKiller()
        if killer then
            beginDrag(killer)
        end
    end)

    State.hooked = true
    print("[HDT] Hooked block button")
end

-- Watch for the button to appear (it may not exist on startup)
task.spawn(function()
    while true do
        task.wait(1)
        tryHookBlockButton()
    end
end)

-- Also trigger when block is fired via RemoteEvent (for auto-block scripts)
-- This catches cases where firesignal is used instead of clicking the button
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Network = ReplicatedStorage:FindFirstChild("Modules")
    and ReplicatedStorage.Modules:FindFirstChild("Network")
    and ReplicatedStorage.Modules.Network:FindFirstChild("Network")

if Network and typeof(hookfunction) == "function" then
    task.spawn(function()
        local ok, remote = pcall(function()
            return Network:WaitForChild("RemoteEvent", 10)
        end)
        if not ok or not remote then return end

        local old
        old = hookfunction(remote.FireServer, function(self, action, ...)
            if action == "UseActorAbility" then
                local args = {...}
                -- Check if it's the block ability
                local isBlock = false
                for _, v in ipairs(args) do
                    if typeof(v) == "table" then
                        for _, inner in ipairs(v) do
                            if tostring(inner):find("Block") then
                                isBlock = true
                                break
                            end
                        end
                    elseif typeof(v) == "string" and v == "Block" then
                        isBlock = true
                    end
                    if isBlock then break end
                end

                if isBlock and Config.Enabled and not State.active then
                    local killer = getNearestKiller()
                    if killer and tick() - lastTrigger > 0.3 then
                        lastTrigger = tick()
                        beginDrag(killer)
                    end
                end
            end
            return old(self, action, ...)
        end)
        print("[HDT] Hooked block remote")
    end)
end

-- ============================================================
-- UI
-- ============================================================
local safeUIParent = (type(gethui) == "function" and gethui()) or PG

local T = {
    bg = Color3.fromRGB(18, 18, 22),
    panel = Color3.fromRGB(28, 28, 34),
    accent = Color3.fromRGB(255, 130, 60),
    text = Color3.fromRGB(240, 240, 248),
    subtext = Color3.fromRGB(150, 150, 168),
    border = Color3.fromRGB(48, 48, 58),
    on = Color3.fromRGB(65, 185, 100),
    off = Color3.fromRGB(190, 60, 60),
}

local function mk(cls, prp, prnt)
    local o = Instance.new(cls)
    for k, v in pairs(prp or {}) do o[k] = v end
    if prnt then o.Parent = prnt end
    return o
end
local function corner(p, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 6); c.Parent = p
end
local function stroke(p)
    local s = Instance.new("UIStroke"); s.Color = T.border; s.Thickness = 1; s.Parent = p
end

local screen = mk("ScreenGui", {
    Name = "HDT", ResetOnSpawn = false, IgnoreGuiInset = true,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, safeUIParent)

local main = mk("Frame", {
    Size = UDim2.new(0, 280, 0, 180),
    Position = UDim2.new(0, 20, 0.5, -90),
    BackgroundColor3 = T.bg, BorderSizePixel = 0, Active = true,
}, screen)
corner(main, 10); stroke(main)

local tb = mk("Frame", {
    Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.panel, BorderSizePixel = 0,
}, main)
corner(tb, 10)
mk("Frame", { Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -14),
    BackgroundColor3 = T.panel, BorderSizePixel = 0 }, tb)
mk("Frame", { Size = UDim2.new(0, 3, 0, 16), Position = UDim2.new(0, 12, 0.5, -8),
    BackgroundColor3 = T.accent, BorderSizePixel = 0 }, tb)

mk("TextLabel", {
    Size = UDim2.new(1, -50, 1, 0), Position = UDim2.new(0, 22, 0, 0),
    BackgroundTransparency = 1, Text = "Hitbox Drag Tech",
    Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = T.text,
    TextXAlignment = Enum.TextXAlignment.Left,
}, tb)

local closeBtn = mk("TextButton", {
    Size = UDim2.new(0, 22, 0, 20), Position = UDim2.new(1, -28, 0, 7),
    BackgroundColor3 = T.off, Text = "X",
    Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = T.text,
    BorderSizePixel = 0,
}, tb)
corner(closeBtn, 4)
closeBtn.MouseButton1Click:Connect(function() screen:Destroy() end)

-- Drag
local dragging, dragStart, startPos
tb.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)

local content = mk("Frame", {
    Size = UDim2.new(1, -16, 1, -46), Position = UDim2.new(0, 8, 0, 40),
    BackgroundTransparency = 1,
}, main)
mk("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, content)

local function addToggle(label, key, cb)
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = T.panel, BorderSizePixel = 0,
    }, content)
    corner(row, 6); stroke(row)
    mk("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1, Text = label,
        Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = T.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local pill = mk("TextButton", {
        Size = UDim2.new(0, 46, 0, 20), Position = UDim2.new(1, -56, 0.5, -10),
        BackgroundColor3 = Config[key] and T.on or T.off,
        Text = Config[key] and "ON" or "OFF",
        Font = Enum.Font.GothamBold, TextSize = 9, TextColor3 = T.text,
        BorderSizePixel = 0,
    }, row)
    corner(pill, 10)
    pill.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        pill.BackgroundColor3 = Config[key] and T.on or T.off
        pill.Text = Config[key] and "ON" or "OFF"
        if cb then cb(Config[key]) end
    end)
end

local function addSlider(label, key, min, max, scale)
    scale = scale or 1
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = T.panel, BorderSizePixel = 0,
    }, content)
    corner(row, 6); stroke(row)
    local lbl = mk("TextLabel", {
        Size = UDim2.new(1, -16, 0, 14), Position = UDim2.new(0, 10, 0, 4),
        BackgroundTransparency = 1, Text = label .. ": " .. tostring(math.floor(Config[key] * scale)),
        Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = T.subtext,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local track = mk("Frame", {
        Size = UDim2.new(1, -20, 0, 5), Position = UDim2.new(0, 10, 0, 26),
        BackgroundColor3 = T.border, BorderSizePixel = 0,
    }, row)
    corner(track, 3)
    local fill = mk("Frame", {
        Size = UDim2.new((Config[key]*scale - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = T.accent, BorderSizePixel = 0,
    }, track)
    corner(fill, 3)
    local drag = false
    local function update(input)
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + rel * (max - min) + 0.5)
        val = math.clamp(val, min, max)
        Config[key] = val / scale
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = label .. ": " .. val
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            drag = true; update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if drag and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
end

addToggle("Enable HDT", "Enabled")
addSlider("Drag Speed ×10", "DragSpeed", 10, 100, 10)
addSlider("Drag Duration ×10", "DragDuration", 1, 15, 10)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        main.Visible = not main.Visible
    end
end)

print("[HDT] Loaded — triggers on block")
